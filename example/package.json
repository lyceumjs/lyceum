{
  "name": "@lyceumjs/lms-example",
  "version": "0.0.0",
  "description": "Dev-only example host + smoke harness for Lyceum. Never published (FR-001).",
  "private": true,
  "license": "MIT",
  "author": "Valery Gutu <valeriu.manifest@gmail.com>",
  "type": "module",
  "scripts": {
    "bundle": "esbuild src/web/main.tsx --bundle --format=iife --jsx=automatic --define:process.env.NODE_ENV='\"production\"' --outfile=public/app.js",
    "dev": "pnpm bundle && tsx src/server.ts",
    "smoke": "vitest run tests"
  },
  "dependencies": {
    "@lyceumjs/lms": "workspace:*",
    "express": "^5.2.1",
    "pg": "^8.13.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^11.0.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "esbuild": "^0.28.0",
    "tsx": "^4.22.4",
    "typescript": "^5.7.0",
    "vitest": "^4.0.0"
  }
}
