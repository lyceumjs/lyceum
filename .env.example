# Lyceum dev-only configuration. Safe placeholders ONLY — never commit real secrets.
# Copy to .env for local development.

# Local dev database (docker-compose). The smoke test ignores this and uses Testcontainers.
DATABASE_URL=postgres://lyceum:lyceum@localhost:5432/lyceum

# Where H5P core/editor static assets and fs storage live (git-ignored).
H5P_DATA_DIR=./h5p-data

# Example dev host port (3021 is reserved for the future admin UI).
PORT=3020
